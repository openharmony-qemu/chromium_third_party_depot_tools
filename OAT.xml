<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="ADSL" path=".*" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="Unknown License" path=".*" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name=".*py"
                    desc="" />
                <filteritem type="filepath" name="gsutil.vpython"
                    desc="" />
                <filteritem type="filepath" name=".*PKG-INFO"
                    desc="" />
                <filteritem type="filepath" name="third_party/colorama/README.chromium"
                    desc="" />
                <filteritem type="filepath" name="external_bin/gsutil/gsutil_4.28/gsutil/third_party.*"
                    desc="" />
                <filteritem type="filepath" name="third_party/colorama/README.rst"
                    desc="" />
            </filefilter>
            <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name=".*cipd_client"
                    desc="" />
                <filteritem type="filepath" name=".*ninja-mac"
                    desc="" />
                <filteritem type="filepath" name="external_bin/gsutil/gsutil_4.28/gsutil.*"
                    desc="" />
                <filteritem type="filepath" name=".*ninja.exe"
                    desc="" />
                <filteritem type="filepath" name="ninja-.*"
                    desc="" />
                <filteritem type="filepath" name=".*png"
                    desc="" />
            </filefilter>
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="Unknown License file reference" desc="">
                <licensetext name="
                SocksiPy version 1.00
                A Python SOCKS module.
                (C) 2006 Dan-Haim. All rights reserved.
                See LICENSE file for details.
            " desc="" />
            </licensematcher>
            <licensematcher name="BSD-3-Clause" desc="">
                <licensetext name="
                URL: http://nedbatchelder.com/code/coverage/
                Version: 3.7
                License: BSD
                License File: PKG-INFO

                Description:
                Coverage.py measures code coverage, typically during test execution.


                Local Modifications:
                Kept only the 'coverage' subdirectory, PKG-INFO, and AUTHORS.txt.
                Removed tracer.c
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>